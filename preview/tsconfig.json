{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@component": ["../CourseGrid.tsx"],
      "framer": ["./src/framer-stub.ts"]
    }
  },
  "include": ["src", "../CourseGrid.tsx"]
}
